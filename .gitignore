/research/**/*.csv
/research/**/*.jsonl
/research/**/*.jsonl.gz
/research/**/*.parquet
/research/start_training_repair_20261001/bundle.json

# Runtime state and personal editor settings are local to each checkout.
/data/state/
/.cursor/settings.json

