      "\n\nfunction goPage1(trDate, trYo){\n    var form = document.form1;\n    form.trDate.value = trDate;\n    form.trYo.value = trYo;\n \n    // 조별 리스트 조회\n    form.action = \"dailyGroupTrainList.do\";\n    form.submit();\n}\n \nfunction goNext(kind){\n    var form = document.form1;\n    var pageNum = form.pageIndex.value;\n    var totPageRest = form.nTotPageRest.value;\n\n    if(pageNum == \"\"){\n        return;\n    }\n\n    if(kind == \"next\"){\n        if(\"false\" == \"true\"){\n            alert(\"마지막 조회 목록입니다.\");\n            return\n        }\n        pageNum = parseInt(pageNum) + 1;\n        form.pageIndex.value = pageNum;\n    }else{\n\n        if(pageNum == \"1\"){\n            alert(\"첫번째 조회 목록입니다.\");\n            return\n        }\n        pageNum = parseInt(pageNum) - 1;\n        form.pageIndex.value = pageNum;\n    }\n\n    form.action = \"dailyDayTrainListSelect.do\";\n    form.submit();\n}\n\n"
